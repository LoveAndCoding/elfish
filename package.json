{
  "name": "@elfish/repo",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "!apps/**/test/**",
      "packages/*",
      "!packages/**/test/**"
    ],
    "catalog": {
      "typescript": "^5"
    }
  },
  "dependencies": {
    "prettier": "^3.8.3"
  },
  "scripts": {
    "format": "prettier --write \"{apps,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"{apps,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\""
  }
}
