{
  "name": "@elfish/repo",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  },
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "typescript": "^5"
    }
  },
  "scripts": {
    "format": "prettier --write \"{apps,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"{apps,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
